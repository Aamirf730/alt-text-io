import React, { useState, useEffect } from "react";
import "./App.css";
import { BrowserRouter, Routes, Route, Link } from "react-router-dom";
import { createClient } from '@supabase/supabase-js';
import { Card, CardContent, CardHeader, CardTitle } from "./components/ui/card";
import { Button } from "./components/ui/button";
import { Input } from "./components/ui/input";
import { Badge } from "./components/ui/badge";
import { Progress } from "./components/ui/progress";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "./components/ui/tabs";
import { Separator } from "./components/ui/separator";
import { toast } from "sonner";
import { Toaster } from "./components/ui/sonner";
import { Brain, Zap, CheckCircle, Star, ArrowRight, Users, Shield, Rocket, Mail, Chrome } from "lucide-react";

// Initialize Supabase client
const supabaseUrl = process.env.REACT_APP_SUPABASE_URL || 'https://placeholder.supabase.co';
const supabaseAnonKey = process.env.REACT_APP_SUPABASE_ANON_KEY || 'placeholder-key';

// Debug logging for Supabase configuration
console.log('🔧 Supabase Configuration Debug:');
console.log('🔧 REACT_APP_SUPABASE_URL:', process.env.REACT_APP_SUPABASE_URL);
console.log('🔧 REACT_APP_SUPABASE_ANON_KEY:', process.env.REACT_APP_SUPABASE_ANON_KEY ? 'SET' : 'NOT SET');
console.log('🔧 Final Supabase URL:', supabaseUrl);
console.log('🔧 Final Supabase Anon Key:', supabaseAnonKey ? 'SET' : 'NOT SET');

const supabase = createClient(supabaseUrl, supabaseAnonKey, {
  auth: {
    autoRefreshToken: true,
    persistSession: true,
    detectSessionInUrl: true,
    flowType: 'pkce',
    // Force the correct site URL
    site: 'https://alt-text-ai.netlify.app'
  }
});

console.log('🔧 Supabase Client Created:', supabase);

// API base URL 
const BACKEND_URL = process.env.REACT_APP_BACKEND_URL;
const API = `${BACKEND_URL}/api`;

// Landing Page Component with Enhanced Auth
const LandingPage = () => {
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [isLoading, setIsLoading] = useState(false);
  const [isGoogleLoading, setIsGoogleLoading] = useState(false);
  const [isLogin, setIsLogin] = useState(false);
  const [showAuthForm, setShowAuthForm] = useState(false);
  const [showPlanModal, setShowPlanModal] = useState(false);
  const [selectedPlan, setSelectedPlan] = useState(null);

  // Debug logging on component mount
  useEffect(() => {
    console.log('🏠 LandingPage Component Mounted');
    console.log('🏠 Environment Variables Check:');
    console.log('🏠 REACT_APP_SUPABASE_URL:', process.env.REACT_APP_SUPABASE_URL);
    console.log('🏠 REACT_APP_SUPABASE_ANON_KEY:', process.env.REACT_APP_SUPABASE_ANON_KEY ? 'SET' : 'NOT SET');
    console.log('🏠 REACT_APP_BACKEND_URL:', process.env.REACT_APP_BACKEND_URL);
    console.log('🏠 NODE_ENV:', process.env.NODE_ENV);
    console.log('🏠 Current Location:', window.location.href);
    console.log('🏠 Current Origin:', window.location.origin);
    
    // Monitor URL changes
    const handleUrlChange = () => {
      console.log('🔄 URL Changed:', window.location.href);
      console.log('🔄 Hash:', window.location.hash);
      console.log('🔄 Search:', window.location.search);
    };
    
    // Listen for URL changes
    window.addEventListener('popstate', handleUrlChange);
    window.addEventListener('hashchange', handleUrlChange);
    
    // Check for OAuth tokens in URL
    if (window.location.hash.includes('access_token') || window.location.search.includes('access_token')) {
      console.log('🔑 OAuth Tokens Detected in URL!');
      console.log('🔑 Full Hash:', window.location.hash);
      console.log('🔑 Full Search:', window.location.search);
    }
    
    return () => {
      window.removeEventListener('popstate', handleUrlChange);
      window.removeEventListener('hashchange', handleUrlChange);
    };
  }, []);

  // Handle email/password authentication
  const handleEmailAuth = async (e) => {
    e.preventDefault();
    if (!email || !password) {
      toast.error("Please enter email and password");
      return;
    }

    setIsLoading(true);
    try {
      let result;
      
      if (isLogin) {
        // Login existing user
        result = await supabase.auth.signInWithPassword({
          email,
          password,
        });
      } else {
        // Register new user
        result = await supabase.auth.signUp({
          email,
          password,
          options: {
            data: {
              subscription_plan: 'free_trial',
              credits_remaining: 30
            }
          }
        });
      }

      if (result.error) {
        if (result.error.message.includes('Email not confirmed')) {
          toast.success("Please check your email and click the confirmation link!");
        } else {
          toast.error(result.error.message);
        }
      } else if (result.data.user) {
        if (!isLogin && !result.data.session) {
          toast.success("Account created! Please check your email to confirm your account.");
        } else {
          toast.success(isLogin ? "Welcome back!" : "Welcome to Alt-Text AI!");
          setTimeout(() => {
            window.location.href = "/dashboard";
          }, 1500);
        }
      }
    } catch (error) {
      console.error("Auth error:", error);
      toast.error("Authentication failed. Please try again.");
    } finally {
      setIsLoading(false);
    }
  };

  // Handle plan selection
  const handlePlanSelection = (plan) => {
    if (plan.id === 'free_trial') {
      setShowAuthForm(true);
    } else {
      setSelectedPlan(plan);
      setShowPlanModal(true);
    }
  };

  // Handle Google OAuth
  const handleGoogleAuth = async () => {
    setIsGoogleLoading(true);
    
    // Debug logging
    console.log('🔍 Google OAuth Debug Info:');
    console.log('📍 Current URL:', window.location.href);
    console.log('📍 Current Origin:', window.location.origin);
    console.log('📍 Supabase URL:', supabaseUrl);
    console.log('📍 Supabase Anon Key:', supabaseAnonKey ? 'SET' : 'NOT SET');
    console.log('📍 Redirect To:', 'https://alt-text-ai.netlify.app/dashboard');
    console.log('📍 Site URL:', 'https://alt-text-ai.netlify.app');
    
    // Check current Supabase session
    try {
      const { data: { session }, error: sessionError } = await supabase.auth.getSession();
      console.log('🔍 Current Supabase Session:', session);
      console.log('🔍 Session Error:', sessionError);
    } catch (e) {
      console.log('🔍 Error checking session:', e);
    }
    
    try {
      console.log('🚀 Starting Google OAuth...');
      
      const { data, error } = await supabase.auth.signInWithOAuth({
        provider: 'google',
        options: {
          redirectTo: 'https://alt-text-ai.netlify.app/dashboard',
          queryParams: {
            access_type: 'offline',
            prompt: 'consent',
          },
          // Force the correct site URL
          site: 'https://alt-text-ai.netlify.app'
        }
      });

      // If we get a URL back, manually redirect to ensure it goes to the right place
      if (data?.url) {
        console.log('🔗 Original OAuth URL:', data.url);
        // Force redirect to our domain
        const forcedUrl = data.url.replace(/localhost:\d+/g, 'alt-text-ai.netlify.app');
        console.log('🔗 Forced Redirect URL:', forcedUrl);
        window.location.href = forcedUrl;
        return;
      }

      console.log('📊 OAuth Response:', { data, error });

      if (error) {
        console.error('❌ OAuth Error:', error);
        toast.error("Google sign-in failed: " + error.message);
      } else {
        console.log('✅ OAuth Success - Data:', data);
        console.log('🔗 Redirect URL:', data?.url);
        console.log('🔗 Full Response Data:', JSON.stringify(data, null, 2));
        toast.success("Redirecting to Google...");
      }
    } catch (error) {
      console.error("❌ Google auth error:", error);
      toast.error("Google sign-in failed. Please try again.");
    } finally {
      setIsGoogleLoading(false);
    }
  };

  // Fallback to old system if Supabase not configured
  const handleFallbackAuth = async (e) => {
    e.preventDefault();
    if (!email) {
      toast.error("Please enter your email address");
      return;
    }

    setIsLoading(true);
    try {
      const response = await fetch(`${API}/auth/register`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email })
      });
      const data = await response.json();
      
      localStorage.setItem("api_token", data.api_token);
      localStorage.setItem("user_email", email);
      toast.success("Welcome to Alt-Text AI! Redirecting to dashboard...");
      setTimeout(() => {
        window.location.href = "/dashboard";
      }, 1500);
    } catch (error) {
      console.error("Registration error:", error);
      toast.error("Failed to register. Please try again.");
    } finally {
      setIsLoading(false);
    }
  };

  const pricingPlans = [
    {
      id: "free_trial",
      name: "Free Trial",
      price: 0,
      credits: 30,
      billing: "one-time",
      features: ["30 AI-generated alt-texts", "Basic support", "WordPress plugin", "No credit card required"],
      popular: false,
      color: "from-teal-500 to-teal-600"
    },
    {
      id: "starter_pack",
      name: "Starter Pack",
      price: 5,
      credits: 1000,
      billing: "one-time",
      features: ["1000 AI alt-texts", "No expiration", "Priority support", "SEO optimization", "Bulk processing"],
      popular: true,
      color: "from-teal-500 to-teal-600"
    },
    {
      id: "growth_pack",
      name: "Growth Pack",
      price: 10,
      credits: 2500,
      billing: "one-time",
      features: ["2500 AI alt-texts", "No expiration", "Premium support", "Advanced analytics", "API access"],
      popular: false,
      color: "from-teal-600 to-teal-700"
    },
    {
      id: "pro_pack",
      name: "Pro Pack",
      price: 20,
      credits: 5000,
      billing: "one-time",
      features: ["5000 AI alt-texts", "No expiration", "Premium support", "Advanced API access", "Custom integrations"],
      popular: false,
      color: "from-teal-700 to-teal-800"
    }
  ];
  return (
    <div className="min-h-screen bg-white">
      {/* Navigation */}
      <nav className="bg-white shadow-subtle border-b border-gray-100 sticky top-0 z-50 backdrop-blur-sm bg-white/95">
        <div className="container-professional">
          <div className="flex justify-between items-center h-16">
            <div className="flex items-center">
              <div className="flex items-center space-x-3">
                <div className="w-10 h-10 bg-gradient-to-r from-teal-600 to-teal-700 rounded-xl flex items-center justify-center shadow-medium">
                  <Brain className="h-6 w-6 text-white" />
                </div>
                <span className="text-2xl font-bold text-gray-900">Alt-Text AI</span>
              </div>
            </div>
            <div className="hidden md:flex items-center space-x-8">
              <a href="#features" className="nav-link">Features</a>
              <a href="#pricing" className="nav-link">Pricing</a>
              <a href="#how-it-works" className="nav-link">How it Works</a>
              <Link to="/dashboard" className="nav-link-active">Dashboard</Link>
              <Button 
                variant="outline" 
                onClick={() => setShowAuthForm(true)}
                className="btn-secondary ml-4"
              >
                Sign In
              </Button>
            </div>
            {/* Mobile menu button */}
            <div className="md:hidden">
              <button className="p-2 rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition-colors">
                <svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M4 6h16M4 12h16M4 18h16" />
                </svg>
              </button>
            </div>
          </div>
        </div>
      </nav>

      {/* Hero Section */}
      <section className="hero-section">
        <div className="hero-content">
          <Badge className="badge-professional mb-8 text-lg px-4 py-2">
            ✨ Powered by Gemini 2.0 Flash + Supabase Auth
          </Badge>
          <h1 className="text-5xl md:text-6xl font-bold text-gray-900 mb-8 leading-tight">
            Generate Perfect
            <span className="bg-gradient-to-r from-teal-600 to-teal-700 bg-clip-text text-transparent"> Alt-Text </span>
            for Your Images
          </h1>
          <p className="text-xl text-gray-600 mb-10 leading-relaxed max-w-3xl mx-auto">
            Boost your WordPress SEO with AI-generated, accessible alt-text. Sign in with email or Google to get started with 100 free credits.
          </p>
          
          {!showAuthForm ? (
            <div className="space-y-6">
              <div className="flex flex-col sm:flex-row gap-4 justify-center items-center">
                <Button
                  onClick={() => setShowAuthForm(true)}
                  className="btn-primary h-14 px-10 text-lg font-semibold shadow-large hover:shadow-xl transform hover:-translate-y-1"
                >
                  Start Free Trial
                  <ArrowRight className="ml-2 h-5 w-5" />
                </Button>
                <Button
                  onClick={handleGoogleAuth}
                  disabled={isGoogleLoading}
                  variant="outline"
                  className="btn-secondary h-14 px-10 text-lg font-semibold border-2"
                >
                  {isGoogleLoading ? (
                    <>
                      <div className="animate-spin rounded-full h-5 w-5 border-b-2 border-teal-600 mr-2"></div>
                      Connecting...
                    </>
                  ) : (
                    <>
                      <Chrome className="mr-2 h-5 w-5 text-teal-600" />
                      Continue with Google
                    </>
                  )}
                </Button>
              </div>
              <div className="text-center">
                <p className="text-gray-500 text-sm">
                  100 free alt-texts • No credit card required • WordPress plugin included
                </p>
              </div>
            </div>
          ) : (
            <Card className="max-w-md mx-auto mt-8">
              <CardHeader className="text-center">
                <CardTitle className="text-2xl">Get Started</CardTitle>
                <p className="text-slate-600">Sign in to your Alt-Text AI account</p>
              </CardHeader>
              <CardContent className="space-y-4">
                {/* Google Sign In Button */}
                <Button
                  onClick={handleGoogleAuth}
                  disabled={isGoogleLoading}
                  variant="outline"
                  className="w-full h-12 text-base font-semibold border-2"
                >
                  {isGoogleLoading ? (
                    <>
                      <div className="animate-spin rounded-full h-5 w-5 border-b-2 border-blue-600 mr-2"></div>
                      Connecting to Google...
                    </>
                  ) : (
                    <>
                      <Chrome className="mr-2 h-5 w-5 text-blue-600" />
                      Continue with Google
                    </>
                  )}
                </Button>

                <div className="relative">
                  <Separator />
                  <div className="absolute inset-0 flex items-center justify-center">
                    <span className="bg-white px-2 text-sm text-slate-500">or</span>
                  </div>
                </div>

                {/* Email/Password Form */}
                <form onSubmit={supabaseUrl !== 'https://placeholder.supabase.co' ? handleEmailAuth : handleFallbackAuth} className="space-y-4">
                  <div>
                    <Input
                      type="email"
                      placeholder="Enter your email address"
                      value={email}
                      onChange={(e) => setEmail(e.target.value)}
                      className="h-12 text-base"
                      disabled={isLoading}
                      required
                    />
                  </div>
                  {supabaseUrl !== 'https://placeholder.supabase.co' && (
                    <div>
                      <Input
                        type="password"
                        placeholder={isLogin ? "Enter your password" : "Create a password"}
                        value={password}
                        onChange={(e) => setPassword(e.target.value)}
                        className="h-12 text-base"
                        disabled={isLoading}
                        required
                        minLength={6}
                      />
                    </div>
                  )}
                  <Button
                    type="submit"
                    disabled={isLoading}
                    className="w-full h-12 bg-gradient-to-r from-violet-600 to-purple-600 hover:from-violet-700 hover:to-purple-700 text-white font-semibold text-base"
                  >
                    {isLoading ? (
                      <>
                        <div className="animate-spin rounded-full h-5 w-5 border-b-2 border-white mr-2"></div>
                        {isLogin ? "Signing in..." : "Creating account..."}
                      </>
                    ) : (
                      <>
                        <Mail className="mr-2 h-5 w-5" />
                        {supabaseUrl !== 'https://placeholder.supabase.co' ? (isLogin ? "Sign In" : "Create Account") : "Start Free Trial"}
                      </>
                    )}
                  </Button>
                </form>

                {supabaseUrl !== 'https://placeholder.supabase.co' && (
                  <div className="text-center">
                    <button
                      type="button"
                      onClick={() => setIsLogin(!isLogin)}
                      className="text-sm text-violet-600 hover:text-violet-700 font-medium"
                    >
                      {isLogin ? "Don't have an account? Sign up" : "Already have an account? Sign in"}
                    </button>
                  </div>
                )}

                <div className="text-center">
                  <button
                    type="button"
                    onClick={() => setShowAuthForm(false)}
                    className="text-sm text-slate-500 hover:text-slate-700"
                  >
                    ← Back to homepage
                  </button>
                </div>
              </CardContent>
            </Card>
          )}

          {!showAuthForm && (
            <div className="flex items-center justify-center space-x-8 text-sm text-slate-500 mt-8">
              <div className="flex items-center">
                <CheckCircle className="h-4 w-4 text-emerald-500 mr-2" />
                30 free alt-texts
              </div>
              <div className="flex items-center">
                <CheckCircle className="h-4 w-4 text-emerald-500 mr-2" />
                No credit card required
              </div>
              <div className="flex items-center">
                <CheckCircle className="h-4 w-4 text-emerald-500 mr-2" />
                WordPress plugin included
              </div>
            </div>
          )}
        </div>
      </section>

      {/* Features Section */}
      <section id="features" className="section-padding bg-gray-50">
        <div className="container-professional">
          <div className="text-center mb-16">
            <h2 className="text-4xl font-bold text-gray-900 mb-6">
              Everything You Need for Perfect Alt-Text
            </h2>
            <p className="text-xl text-gray-600 max-w-3xl mx-auto">
              Powerful features designed to enhance your website's accessibility and SEO
            </p>
          </div>

          <div className="grid md:grid-cols-3 gap-8">
            <div className="card-hover text-center hover-lift">
              <div className="bg-gradient-to-r from-teal-600 to-teal-700 w-20 h-20 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-medium">
                <Brain className="h-10 w-10 text-white" />
              </div>
              <h3 className="text-xl font-semibold text-gray-900 mb-4">AI-Powered Generation</h3>
              <p className="text-gray-600">
                Advanced Gemini 2.0 Flash AI analyzes your images and generates contextually accurate, SEO-optimized alt-text in seconds.
              </p>
            </div>

            <div className="card-hover text-center hover-lift">
              <div className="bg-gradient-primary w-20 h-20 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-medium">
                <Zap className="h-10 w-10 text-white" />
              </div>
              <h3 className="text-xl font-semibold text-gray-900 mb-4">WordPress Integration</h3>
              <p className="text-gray-600">
                Seamless WordPress plugin automatically generates alt-text on image upload and provides bulk processing for existing images.
              </p>
            </div>

            <div className="card-hover text-center hover-lift">
              <div className="bg-gradient-purple w-20 h-20 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-medium">
                <Rocket className="h-10 w-10 text-white" />
              </div>
              <h3 className="text-xl font-semibold text-gray-900 mb-4">SEO Optimization</h3>
              <p className="text-gray-600">
                Every generated alt-text is optimized for search engines while maintaining natural readability and accessibility compliance.
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* How It Works Section */}
      <section id="how-it-works" className="py-20 bg-slate-50">
        <div className="max-w-7xl mx-auto px-6">
          <div className="text-center mb-16">
            <h2 className="text-4xl font-bold text-slate-800 mb-4">
              How Alt-Text AI Works
            </h2>
            <p className="text-xl text-slate-600">
              Get up and running in minutes with our simple 3-step process
            </p>
          </div>

          <div className="grid md:grid-cols-3 gap-8">
            <div className="text-center">
              <div className="bg-gradient-to-r from-violet-500 to-purple-600 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-6">
                <span className="text-2xl font-bold text-white">1</span>
              </div>
              <h3 className="text-xl font-semibold text-slate-800 mb-4">Sign Up & Get API Key</h3>
              <p className="text-slate-600">
                Register for your free account and receive your API token instantly. No credit card required for the trial.
              </p>
            </div>

            <div className="text-center">
              <div className="bg-gradient-to-r from-emerald-500 to-teal-600 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-6">
                <span className="text-2xl font-bold text-white">2</span>
              </div>
              <h3 className="text-xl font-semibold text-slate-800 mb-4">Install WordPress Plugin</h3>
              <p className="text-slate-600">
                Download and install our WordPress plugin, then enter your API token in the settings page.
              </p>
            </div>

            <div className="text-center">
              <div className="bg-gradient-to-r from-orange-500 to-red-600 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-6">
                <span className="text-2xl font-bold text-white">3</span>
              </div>
              <h3 className="text-xl font-semibold text-slate-800 mb-4">Automatic Alt-Text</h3>
              <p className="text-slate-600">
                Upload images as usual. Alt-text is generated automatically, or use bulk processing for existing images.
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* Pricing Section */}
      <section id="pricing" className="py-20 bg-white">
        <div className="max-w-7xl mx-auto px-6">
          <div className="text-center mb-16">
            <h2 className="text-4xl font-bold text-slate-800 mb-4">
              Simple, Transparent Pricing
            </h2>
            <p className="text-xl text-slate-600">
              Pay-as-you-go pricing with no monthly commitments. Buy credits once, use them anytime.
            </p>
          </div>

          <div className="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
            {pricingPlans.map((plan, index) => (
              <Card key={plan.id} className={`relative border-0 shadow-lg hover:shadow-xl transition-all duration-300 ${plan.popular ? 'ring-2 ring-emerald-500 scale-105' : ''}`}>
                {plan.popular && (
                  <div className="absolute -top-4 left-1/2 transform -translate-x-1/2">
                    <Badge className="bg-emerald-500 text-white px-4 py-1">
                      <Star className="h-3 w-3 mr-1" />
                      Most Popular
                    </Badge>
                  </div>
                )}
                
                <CardHeader className="text-center pb-4">
                  <div className={`bg-gradient-to-r ${plan.color} w-12 h-12 rounded-xl flex items-center justify-center mx-auto mb-4`}>
                    <span className="text-white font-bold text-lg">{plan.name[0]}</span>
                  </div>
                  <CardTitle className="text-xl mb-2">{plan.name}</CardTitle>
                  <div className="mb-4">
                    <span className="text-4xl font-bold text-slate-800">${plan.price}</span>
                    <span className="text-slate-500">/{plan.billing === 'monthly' ? 'mo' : plan.billing}</span>
                  </div>
                  <p className="text-emerald-600 font-semibold">{plan.credits} alt-texts</p>
                </CardHeader>
                
                <CardContent>
                  <ul className="space-y-3 mb-6">
                    {plan.features.map((feature, featureIndex) => (
                      <li key={featureIndex} className="flex items-center text-sm text-slate-600">
                        <CheckCircle className="h-4 w-4 text-emerald-500 mr-3 flex-shrink-0" />
                        {feature}
                      </li>
                    ))}
                  </ul>
                  
                  <Button 
                    className={`w-full bg-gradient-to-r ${plan.color} hover:opacity-90 text-white`}
                    onClick={() => handlePlanSelection(plan)}
                  >
                    {plan.id === 'free_trial' ? 'Start Free Trial' : 'Choose Plan'}
                  </Button>
                </CardContent>
              </Card>
            ))}
          </div>
        </div>
      </section>

      {/* Plan Upgrade Modal */}
      {showPlanModal && selectedPlan && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl">
            <div className="text-center mb-6">
              <div className={`w-16 h-16 bg-gradient-to-r ${selectedPlan.color} rounded-2xl flex items-center justify-center mx-auto mb-4`}>
                <span className="text-2xl font-bold text-white">
                  {selectedPlan.id === 'starter' ? '🚀' : selectedPlan.id === 'pro' ? '⚡' : '💎'}
                </span>
              </div>
              <h3 className="text-2xl font-bold text-gray-900 mb-2">{selectedPlan.name} Plan</h3>
              <p className="text-gray-600">Upgrade your account to unlock more features</p>
            </div>
            
            <div className="mb-6">
              <div className="text-center mb-4">
                <span className="text-4xl font-bold text-gray-900">${selectedPlan.price}</span>
                <span className="text-gray-600 ml-2">
                  {selectedPlan.billing === 'monthly' ? '/month' : selectedPlan.billing === 'credits' ? ' for ' + selectedPlan.credits + ' credits' : ''}
                </span>
              </div>
              
              <ul className="space-y-3 mb-6">
                {selectedPlan.features.map((feature, index) => (
                  <li key={index} className="flex items-start">
                    <CheckCircle className="h-5 w-5 text-teal-500 mr-3 flex-shrink-0 mt-0.5" />
                    <span className="text-gray-700">{feature}</span>
                  </li>
                ))}
              </ul>
            </div>
            
            <div className="flex space-x-3">
              <Button 
                variant="outline" 
                className="flex-1"
                onClick={() => setShowPlanModal(false)}
              >
                Cancel
              </Button>
              <Button 
                className={`flex-1 bg-gradient-to-r ${selectedPlan.color} hover:opacity-90 text-white`}
                onClick={() => {
                  toast.info(`Upgrade to ${selectedPlan.name} plan - Contact us for enterprise pricing!`);
                  setShowPlanModal(false);
                }}
              >
                Upgrade Now
              </Button>
            </div>
          </div>
        </div>
      )}

      {/* CTA Section */}
      <section className="py-20 bg-gradient-to-r from-teal-600 to-teal-700">
        <div className="max-w-4xl mx-auto text-center px-6">
          <h2 className="text-4xl font-bold text-white mb-6">
            Ready to Boost Your WordPress SEO?
          </h2>
          <p className="text-xl text-teal-100 mb-8">
            Join thousands of WordPress users who trust Alt-Text AI for better accessibility and SEO rankings.
          </p>
          
          <div className="flex items-center justify-center space-x-8 mb-8">
            <div className="flex items-center text-teal-100">
              <Users className="h-5 w-5 mr-2" />
              <span>10,000+ images processed</span>
            </div>
            <div className="flex items-center text-teal-100">
              <Shield className="h-5 w-5 mr-2" />
              <span>WCAG 2.1 compliant</span>
            </div>
          </div>
          
          <Button 
            size="lg" 
            className="bg-white text-teal-600 hover:bg-teal-50 font-semibold px-8 py-3 text-lg"
            onClick={() => setShowAuthForm(true)}
          >
            Start Your Free Trial
            <ArrowRight className="ml-2 h-5 w-5" />
          </Button>
        </div>
      </section>

      {/* Footer */}
      <footer className="bg-slate-800 text-slate-300 py-12">
        <div className="max-w-7xl mx-auto px-6">
          <div className="grid md:grid-cols-4 gap-8">
            <div>
              <div className="flex items-center space-x-3 mb-4">
                <div className="bg-gradient-to-r from-teal-500 to-teal-600 p-2 rounded-xl">
                  <Brain className="h-5 w-5 text-white" />
                </div>
                <span className="text-xl font-bold text-white">Alt-Text AI</span>
              </div>
              <p className="text-slate-400">
                AI-powered alt-text generation for better accessibility and SEO.
              </p>
            </div>
            
            <div>
              <h4 className="font-semibold text-white mb-4">Product</h4>
              <ul className="space-y-2">
                <li><a href="#features" className="hover:text-white transition-colors">Features</a></li>
                <li><a href="#pricing" className="hover:text-white transition-colors">Pricing</a></li>
                <li><Link to="/dashboard" className="hover:text-white transition-colors">Dashboard</Link></li>
                <li><a href="#" className="hover:text-white transition-colors">WordPress Plugin</a></li>
              </ul>
            </div>
            
            <div>
              <h4 className="font-semibold text-white mb-4">Support</h4>
              <ul className="space-y-2">
                <li><a href="#" className="hover:text-white transition-colors">Documentation</a></li>
                <li><a href="#" className="hover:text-white transition-colors">API Reference</a></li>
                <li><a href="#" className="hover:text-white transition-colors">Help Center</a></li>
                <li><a href="#" className="hover:text-white transition-colors">Contact</a></li>
              </ul>
            </div>
            
            <div>
              <h4 className="font-semibold text-white mb-4">Company</h4>
              <ul className="space-y-2">
                <li><a href="#" className="hover:text-white transition-colors">About</a></li>
                <li><a href="#" className="hover:text-white transition-colors">Privacy</a></li>
                <li><a href="#" className="hover:text-white transition-colors">Terms</a></li>
                <li><a href="#" className="hover:text-white transition-colors">Blog</a></li>
              </ul>
            </div>
          </div>
          
          <div className="border-t border-slate-700 mt-8 pt-8 text-center">
            <p className="text-slate-400">
              © 2025 Alt-Text AI. All rights reserved. Powered by Gemini 2.0 Flash.
            </p>
          </div>
        </div>
      </footer>
    </div>
  );
};

// Dashboard Component
const Dashboard = () => {
  const [user, setUser] = useState(null);
  const [usageStats, setUsageStats] = useState(null);
  const [testImage, setTestImage] = useState(null);
  const [testResult, setTestResult] = useState(null);
  const [isLoading, setIsLoading] = useState(true);
  const [isGenerating, setIsGenerating] = useState(false);

  useEffect(() => {
    loadDashboard();
  }, []);

  const loadDashboard = async () => {
    console.log('🔍 Dashboard Loading - Checking Supabase Session...');
    
    try {
      // Check Supabase session first
      const { data: { session }, error: sessionError } = await supabase.auth.getSession();
      console.log('🔍 Supabase Session Check:', { session, sessionError });
      
      if (sessionError) {
        console.error('❌ Session Error:', sessionError);
        toast.error("Failed to check authentication. Please try logging in again.");
        window.location.href = "/";
        return;
      }
      
      if (!session) {
        console.log('❌ No Supabase session found, redirecting to login');
        toast.error("Please sign in to access the dashboard");
        window.location.href = "/";
        return;
      }
      
      console.log('✅ Supabase session found:', session.user.email);
      
      // Get or create user's API key
      const apiKey = await getUserApiKey(session.user.id, session.user.email);
      
      setUser({ 
        email: session.user.email, 
        id: session.user.id,
        token: session.access_token,
        apiKey: apiKey
      });
      
      // Fetch real usage data from API
      try {
        const usageResponse = await fetch('https://alt-text-ai.netlify.app/.netlify/functions/get-usage', {
          headers: {
            'Authorization': `Bearer ${apiKey}`
          }
        });
        
        if (usageResponse.ok) {
          const usageData = await usageResponse.json();
          console.log('✅ Fetched real usage data:', usageData);
          setUsageStats({
            credits_remaining: usageData.credits_remaining,
            total_processed: usageData.total_processed,
            plan: usageData.current_plan
          });
                          } else {
                    console.log('⚠️ Using default usage stats');
                    setUsageStats({
                      credits_remaining: 100,
                      total_processed: 0,
                      plan: 'Free Trial'
                    });
                  }
                      } catch (error) {
                  console.error('❌ Error fetching usage data:', error);
                  setUsageStats({
                    credits_remaining: 100,
                    total_processed: 0,
                    plan: 'Free Trial'
                  });
                }
      
      setIsLoading(false);
    } catch (error) {
      console.error("❌ Failed to load dashboard:", error);
      toast.error("Failed to load dashboard. Please try logging in again.");
      window.location.href = "/";
    }
  };

  // Function to get or create user's API key
  const getUserApiKey = async (userId, userEmail) => {
    try {
      // Check if existing API key is in the correct format
      const existingKey = localStorage.getItem(`api_key_${userId}`);
      if (existingKey && existingKey.startsWith('altai_')) {
        console.log('🔑 Found existing valid API key in localStorage');
        return existingKey;
      }
      
      // If no key exists or key is in wrong format, generate a new one
      console.log('🔑 Generating new API key (existing key invalid or missing)');
      const newApiKey = generateApiKey(userId, userEmail);
      
      // Store in localStorage for this user
      localStorage.setItem(`api_key_${userId}`, newApiKey);
      
      return newApiKey;
    } catch (error) {
      console.error('❌ Error getting API key:', error);
      // Fallback to a basic key
      return generateApiKey(userId, userEmail);
    }
  };

  // Function to generate a unique API key
  const generateApiKey = (userId, userEmail) => {
    // Create a unique key based on user ID, email, and timestamp
    const timestamp = Date.now();
    const uniqueString = `${userId}_${userEmail}_${timestamp}`;
    
    // Generate a hash-like string (simple implementation)
    let hash = 0;
    for (let i = 0; i < uniqueString.length; i++) {
      const char = uniqueString.charCodeAt(i);
      hash = ((hash << 5) - hash) + char;
      hash = hash & hash; // Convert to 32-bit integer
    }
    
    // Convert to base36 and add some randomness
    const base36Hash = Math.abs(hash).toString(36);
    const randomPart = Math.random().toString(36).substring(2, 8);
    
    // Format: altai_[hash]_[random]_[timestamp] (matches WordPress plugin expectation)
    return `altai_${base36Hash}_${randomPart}_${timestamp.toString(36)}`;
  };

  const handleImageUpload = (event) => {
    const file = event.target.files[0];
    if (file && file.type.startsWith('image/')) {
      const reader = new FileReader();
      reader.onload = (e) => {
        setTestImage(e.target.result);
        setTestResult(null);
      };
      reader.readAsDataURL(file);
    }
  };

  const generateTestAltText = async () => {
    if (!testImage) {
      toast.error("Please upload an image first");
      return;
    }

    if (!user?.apiKey) {
      toast.error("API key required. Please generate a new API key.");
      return;
    }

    setIsGenerating(true);
    try {
      const base64Data = testImage.split(',')[1];
      
      console.log('🔍 Calling real API for alt-text generation for:', user.email);
      
      // Call the real Netlify function
      const response = await fetch('https://alt-text-ai.netlify.app/.netlify/functions/generate-alt-text', {
        method: 'POST',
        headers: { 
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${user.apiKey}`
        },
        body: JSON.stringify({ 
          image_base64: base64Data,
          context: 'Dashboard test'
        })
      });
      
      const data = await response.json();
      
      if (response.ok) {
        console.log('✅ Alt-text generated successfully:', data);
        setTestResult(data);
        
        // Update usage stats with real data from API
        setUsageStats(prev => ({
          ...prev,
          credits_remaining: data.credits_remaining,
          total_processed: data.total_processed
        }));
        
        toast.success("Alt-text generated successfully!");
      } else {
        console.error('❌ API error:', data);
        if (response.status === 402) {
          toast.error("No credits remaining. Please upgrade your plan.");
        } else if (response.status === 401) {
          toast.error("Invalid API key. Please generate a new one.");
        } else {
          toast.error(data.error || "Failed to generate alt-text. Please try again.");
        }
      }
    } catch (error) {
      console.error("Failed to generate alt-text:", error);
      toast.error("Failed to generate alt-text. Please try again.");
    } finally {
      setIsGenerating(false);
    }
  };

  if (isLoading) {
    return (
      <div className="min-h-screen bg-slate-50 flex items-center justify-center">
        <div className="text-center">
          <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-violet-600 mx-auto mb-4"></div>
          <p className="text-slate-600">Loading dashboard...</p>
        </div>
      </div>
    );
  }

  const progressPercentage = usageStats ? ((usageStats.total_processed / (usageStats.total_processed + usageStats.credits_remaining)) * 100) : 0;

  return (
    <div className="min-h-screen bg-slate-50">
      {/* Navigation */}
      <nav className="bg-white border-b border-slate-200">
        <div className="max-w-7xl mx-auto px-6 py-4">
          <div className="flex items-center justify-between">
            <Link to="/" className="flex items-center space-x-3">
              <div className="bg-gradient-to-r from-violet-500 to-purple-600 p-2 rounded-xl">
                <Brain className="h-6 w-6 text-white" />
              </div>
              <span className="text-2xl font-bold text-slate-800">Alt-Text AI</span>
            </Link>
            <div className="flex items-center space-x-4">
              <span className="text-slate-600">Welcome, {user?.email}</span>
              <Button
                variant="outline"
                onClick={async () => {
                  try {
                    console.log('🔍 Logging out user:', user?.email);
                    const { error } = await supabase.auth.signOut();
                    if (error) {
                      console.error('❌ Logout error:', error);
                      toast.error("Logout failed. Please try again.");
                    } else {
                      console.log('✅ Logout successful');
                      toast.success("Logged out successfully");
                      window.location.href = "/";
                    }
                  } catch (error) {
                    console.error('❌ Logout error:', error);
                    toast.error("Logout failed. Please try again.");
                  }
                }}
              >
                Logout
              </Button>
            </div>
          </div>
        </div>
      </nav>

      <div className="max-w-7xl mx-auto px-6 py-8">
        <div className="mb-8">
          <h1 className="text-3xl font-bold text-slate-800 mb-2">Dashboard</h1>
          <p className="text-slate-600">Manage your Alt-Text AI subscription and test the service</p>
        </div>

        <div className="grid lg:grid-cols-3 gap-8">
          {/* Usage Stats */}
          <div className="lg:col-span-1">
            <Card className="mb-6">
              <CardHeader>
                <CardTitle className="flex items-center">
                  <Zap className="h-5 w-5 mr-2 text-violet-600" />
                  Usage Statistics
                </CardTitle>
              </CardHeader>
              <CardContent className="space-y-4">
                <div>
                  <div className="flex justify-between items-center mb-2">
                    <span className="text-sm text-slate-600">Current Plan</span>
                    <Badge className="bg-violet-100 text-violet-700">
                      {usageStats?.plan || 'Free Trial'}
                    </Badge>
                  </div>
                </div>
                
                <div>
                  <div className="flex justify-between items-center mb-2">
                    <span className="text-sm text-slate-600">Credits Remaining</span>
                    <span className="font-semibold text-slate-800">
                      {usageStats?.credits_remaining || 0}
                    </span>
                  </div>
                  <Progress value={(usageStats?.credits_remaining / 100) * 100} className="h-2" />
                </div>
                
                <div>
                  <div className="flex justify-between items-center">
                    <span className="text-sm text-slate-600">Total Processed</span>
                    <span className="font-semibold text-slate-800">
                      {usageStats?.total_processed || 0}
                    </span>
                  </div>
                </div>

                {usageStats?.plan_expires && (
                  <div>
                    <div className="flex justify-between items-center">
                      <span className="text-sm text-slate-600">Plan Expires</span>
                      <span className="text-sm text-slate-800">
                        {new Date(usageStats.plan_expires).toLocaleDateString()}
                      </span>
                    </div>
                  </div>
                )}
              </CardContent>
            </Card>

            <Card>
              <CardHeader>
                <CardTitle>API Integration</CardTitle>
              </CardHeader>
              <CardContent className="space-y-4">
                <div>
                  <label className="text-sm text-slate-600 mb-2 block">Your API Key</label>
                  <div className="bg-slate-100 p-3 rounded-lg font-mono text-sm break-all">
                    {user?.apiKey || 'Loading...'}
                  </div>
                  <p className="text-xs text-slate-500 mt-2">
                    Use this unique API key in your WordPress plugin settings
                  </p>
                </div>
                
                <div className="flex space-x-2">
                  <Button
                    variant="outline"
                    size="sm"
                    onClick={() => {
                      if (user?.apiKey) {
                        navigator.clipboard.writeText(user.apiKey);
                        toast.success("API key copied to clipboard!");
                      }
                    }}
                    disabled={!user?.apiKey}
                  >
                    Copy API Key
                  </Button>
                  <Button
                    variant="outline"
                    size="sm"
                    onClick={async () => {
                      if (user?.id && user?.email) {
                        const newKey = generateApiKey(user.id, user.email);
                        localStorage.setItem(`api_key_${user.id}`, newKey);
                        setUser(prev => ({ ...prev, apiKey: newKey }));
                        toast.success("New API key generated!");
                      }
                    }}
                  >
                    Generate New Key
                  </Button>
                </div>
                
                <div className="space-y-2">
                  <h4 className="font-medium text-slate-800">WordPress Plugin Setup:</h4>
                  <ol className="text-sm text-slate-600 space-y-1 list-decimal list-inside">
                    <li>Download the Alt-Text AI WordPress plugin</li>
                    <li>Install and activate the plugin</li>
                    <li>Go to Settings → Alt-Text AI</li>
                    <li>Paste your unique API key above</li>
                    <li>Save settings and start generating alt-text!</li>
                  </ol>
                  <div className="mt-3 p-3 bg-blue-50 border border-blue-200 rounded-lg">
                    <p className="text-xs text-blue-700">
                      <strong>Note:</strong> Each user gets a unique API key starting with "altai_". Keep your key secure and don't share it with others.
                    </p>
                  </div>
                </div>
              </CardContent>
            </Card>
          </div>

          {/* Test Service */}
          <div className="lg:col-span-2">
            <Card>
              <CardHeader>
                <CardTitle>Test Alt-Text Generation</CardTitle>
                <p className="text-slate-600">Upload an image to test our AI-powered alt-text generation</p>
              </CardHeader>
              <CardContent>
                <Tabs defaultValue="upload" className="space-y-6">
                  <TabsList>
                    <TabsTrigger value="upload">Upload Image</TabsTrigger>
                    <TabsTrigger value="result" disabled={!testResult}>Generated Result</TabsTrigger>
                  </TabsList>
                  
                  <TabsContent value="upload" className="space-y-6">
                    <div>
                      <input
                        type="file"
                        accept="image/*"
                        onChange={handleImageUpload}
                        className="mb-4 block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-violet-50 file:text-violet-700 hover:file:bg-violet-100"
                      />
                      
                      {testImage && (
                        <div className="space-y-4">
                          <div className="border-2 border-dashed border-slate-300 rounded-lg p-4">
                            <img
                              src={testImage}
                              alt="Test upload"
                              className="max-w-full max-h-64 mx-auto rounded-lg"
                            />
                          </div>
                          
                          <Button
                            onClick={generateTestAltText}
                            disabled={isGenerating || usageStats?.credits_remaining <= 0}
                            className="w-full bg-gradient-to-r from-violet-600 to-purple-600 hover:from-violet-700 hover:to-purple-700"
                          >
                            {isGenerating ? (
                              <>
                                <div className="animate-spin rounded-full h-4 w-4 border-b-2 border-white mr-2"></div>
                                Generating Alt-Text...
                              </>
                            ) : (
                              <>
                                <Brain className="h-4 w-4 mr-2" />
                                Generate Alt-Text ({usageStats?.credits_remaining || 0} credits left)
                              </>
                            )}
                          </Button>
                        </div>
                      )}
                    </div>
                  </TabsContent>
                  
                  <TabsContent value="result" className="space-y-6">
                    {testResult && (
                      <div className="space-y-4">
                        <div className="bg-emerald-50 border border-emerald-200 rounded-lg p-4">
                          <h4 className="font-semibold text-emerald-800 mb-2">Generated Alt-Text:</h4>
                          <p className="text-emerald-700 text-lg font-medium">
                            "{testResult.alt_text}"
                          </p>
                        </div>
                        
                        <div className="grid grid-cols-2 gap-4">
                          <div className="bg-slate-50 rounded-lg p-4">
                            <div className="text-sm text-slate-600">Credits Used</div>
                            <div className="text-2xl font-bold text-slate-800">{testResult.credits_used}</div>
                          </div>
                          <div className="bg-slate-50 rounded-lg p-4">
                            <div className="text-sm text-slate-600">Credits Remaining</div>
                            <div className="text-2xl font-bold text-slate-800">{testResult.credits_remaining}</div>
                          </div>
                        </div>
                        
                        <Button
                          variant="outline"
                          onClick={() => {
                            setTestImage(null);
                            setTestResult(null);
                          }}
                          className="w-full"
                        >
                          Test Another Image
                        </Button>
                      </div>
                    )}
                  </TabsContent>
                </Tabs>
              </CardContent>
            </Card>
          </div>
        </div>
      </div>
    </div>
  );
};

// Main App Component
function App() {
  return (
    <div className="App">
      <BrowserRouter>
        <Routes>
          <Route path="/" element={<LandingPage />} />
          <Route path="/dashboard" element={<Dashboard />} />
        </Routes>
      </BrowserRouter>
      <Toaster />
    </div>
  );
}

export default App;