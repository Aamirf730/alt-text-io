# ═══════════════════════════════════════════════════════════════════════════════
# Alt Text Pro Frontend — Environment Variables Template
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local files to git!
#
# For production (Netlify), set these in the Netlify Dashboard:
#   Site Settings > Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Polar.sh Configuration
POLAR_ACCESS_TOKEN=your-polar-access-token
POLAR_WEBHOOK_SECRET=your-polar-webhook-secret
POLAR_ENVIRONMENT=production
NEXT_PUBLIC_SITE_URL=https://www.alt-text.pro

# Polar.sh Product IDs
NEXT_PUBLIC_POLAR_TIER1_MONTHLY=your-product-id
NEXT_PUBLIC_POLAR_TIER1_ANNUAL=your-product-id
NEXT_PUBLIC_POLAR_TIER2_MONTHLY=your-product-id
NEXT_PUBLIC_POLAR_TIER2_ANNUAL=your-product-id
NEXT_PUBLIC_POLAR_TIER3_MONTHLY=your-product-id
NEXT_PUBLIC_POLAR_TIER3_ANNUAL=your-product-id
NEXT_PUBLIC_POLAR_TIER4_MONTHLY=your-product-id
NEXT_PUBLIC_POLAR_TIER4_ANNUAL=your-product-id
NEXT_PUBLIC_POLAR_SMALL_PACK=your-product-id
NEXT_PUBLIC_POLAR_CREDIT_PACK=your-product-id
NEXT_PUBLIC_POLAR_FREE=your-product-id

# API Base URL
# Development: http://localhost:9999/.netlify/functions
# Production: /.netlify/functions (relative path — Netlify resolves this)
NEXT_PUBLIC_API_BASE=http://localhost:9999/.netlify/functions

# Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID=1728570404806729

# AI Model Configuration
GEMINI_MODEL=models/gemini-2.5-flash
